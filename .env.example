APP_ENV=development
DATABASE_PATH=./code-review.db
GITHUB_APP_ID=
# Docker Compose path. For direct local runs, use ./.secrets/github-app-private-key.pem.
GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app-private-key.pem
GITHUB_WEBHOOK_SECRET=
GITHUB_ALLOWED_REPOS=owner/repo
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=
SQS_QUEUE_URL=
SQS_VISIBILITY_TIMEOUT_SECONDS=900
SANDBOX_ROOT=./.sandboxes
STALE_RUN_AFTER_MINUTES=60
REVIEW_PIPELINE_PROVIDER=deterministic
MODEL_API_KEY=
MODEL_BASE_URL=https://api.minimax.io/anthropic
MODEL_NAME=MiniMax-M2.7
MODEL_MAX_TOKENS=4000
MODEL_INPUT_PRICE_PER_MILLION_TOKENS=0.30
MODEL_OUTPUT_PRICE_PER_MILLION_TOKENS=1.20
